---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { categories, projects } from '../data/projects';
---
<BaseLayout>
  <Header />
  <main>
    <section class="hero shell">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-copy">
        <span class="availability"><i></i> MULTI-ARCH IMAGES · COMMUNITY CURATED</span>
        <h1>Deploy less.<br /><em>Build more.</em></h1>
        <p>
          一个持续维护的多架构 Docker 项目集合。
          发现合适的镜像，在几分钟内完成清晰可靠的自托管部署。
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#projects">Explore containers <span>↓</span></a>
          <a class="btn" href="https://github.com/enwaiax/awesome-docker">View source <span>↗</span></a>
        </div>
        <div class="hero-stats">
          <div><strong>{projects.length}</strong><span>curated images</span></div>
          <div><strong>2+</strong><span>CPU architectures</span></div>
          <div><strong>MIT</strong><span>open source</span></div>
        </div>
      </div>

      <div class="hero-visual" aria-label="Container deployment preview">
        <div class="orbit orbit-a"></div><div class="orbit orbit-b"></div>
        <div class="terminal">
          <div class="terminal-bar"><span></span><span></span><span></span><em>deploy.sh</em></div>
          <div class="terminal-body mono">
            <p><b>$</b> docker compose up -d</p>
            <p><i>✓</i> Pulling image <span>done</span></p>
            <p><i>✓</i> Creating network <span>done</span></p>
            <p><i>✓</i> Starting service <span>done</span></p>
            <p class="ready"><span class="pulse"></span> container is healthy</p>
          </div>
        </div>
        <div class="float-card architecture"><small>ARCHITECTURES</small><strong>amd64 <span>+</span> arm64</strong></div>
        <div class="float-card registry"><small>REGISTRY</small><strong><i></i> image ready</strong></div>
        <div class="container-cube"><span>01</span><i></i><b></b></div>
      </div>
    </section>

    <section class="ticker" aria-label="Featured capabilities">
      <div>
        <span>DOCKER COMPOSE</span><i>◆</i><span>MULTI ARCH</span><i>◆</i><span>SELF HOSTED</span><i>◆</i><span>PRACTICAL GUIDES</span><i>◆</i><span>OPEN SOURCE</span><i>◆</i>
        <span>DOCKER COMPOSE</span><i>◆</i><span>MULTI ARCH</span><i>◆</i><span>SELF HOSTED</span><i>◆</i><span>PRACTICAL GUIDES</span><i>◆</i><span>OPEN SOURCE</span><i>◆</i>
      </div>
    </section>

    <section class="catalog shell" id="projects">
      <div class="section-head">
        <div><span class="eyebrow">Container catalog</span><h2>Choose your next stack.</h2></div>
        <p>不是一个链接坟场。每个条目都有部署路径、架构信息、持久化说明和明确的维护状态。</p>
      </div>
      <div class="catalog-tools">
        <label class="search"><span>⌕</span><input data-search type="search" placeholder="搜索项目、用途或标签…" /></label>
        <div class="filters" data-filters>
          {categories.map((category, index) => <button class:list={{ active: index === 0 }} data-category={category}>{category}</button>)}
        </div>
      </div>
      <div class="project-grid" data-project-grid>
        {projects.map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
      </div>
      <p class="empty" data-empty hidden>没有匹配的容器。试试其他关键词或分类。</p>
    </section>

    <section class="principles shell">
      <div class="principles-copy"><span class="eyebrow">Built to last</span><h2>文档只是表面。<br />可维护性才是产品。</h2></div>
      <div class="principle-list">
        <article><span>01</span><div><h3>Architecture first</h3><p>明确列出经过构建的 CPU 架构，而不是让用户部署后才发现不兼容。</p></div></article>
        <article><span>02</span><div><h3>Honest lifecycle</h3><p>区分 maintained、community 和 archived，历史项目也有清晰的去向。</p></div></article>
        <article><span>03</span><div><h3>Copy. Run. Understand.</h3><p>快速命令负责起步，端口、卷、风险说明负责让你知道它为什么能运行。</p></div></article>
      </div>
    </section>

    <section class="cta shell">
      <div><span class="eyebrow">Open collection</span><h2>Bring a useful container.</h2><p>发现值得多架构运行的项目？提交建议、完善部署指南，或者帮助验证旧镜像。</p></div>
      <a class="btn btn-primary" href="https://github.com/enwaiax/awesome-docker/issues/new">Start a contribution <span>↗</span></a>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-project-card]')];
  const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-category]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  let selectedCategory = '全部';
  const apply = () => {
    const query = search?.value.trim().toLowerCase() ?? '';
    let visible = 0;
    cards.forEach((card) => {
      const matchesQuery = !query || card.dataset.search?.includes(query);
      const matchesCategory = selectedCategory === '全部' || card.dataset.category === selectedCategory;
      const show = Boolean(matchesQuery && matchesCategory);
      card.hidden = !show;
      if (show) visible += 1;
    });
    if (empty) empty.hidden = visible !== 0;
  };
  search?.addEventListener('input', apply);
  filterButtons.forEach((button) => button.addEventListener('click', () => {
    selectedCategory = button.dataset.category ?? '全部';
    filterButtons.forEach((item) => item.classList.toggle('active', item === button));
    apply();
  }));

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion) {
    const visual = document.querySelector<HTMLElement>('.hero-visual');
    window.addEventListener('pointermove', (event) => {
      if (!visual) return;
      const x = (event.clientX / window.innerWidth - .5) * 8;
      const y = (event.clientY / window.innerHeight - .5) * 8;
      visual.style.transform = `translate3d(${x}px, ${y}px, 0)`;
    });
  }
</script>

<style>
  .hero { min-height: 720px; padding: 80px 0 92px; display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: 42px; position: relative; }
  .hero-grid { position: absolute; inset: 0 -20vw; z-index: -1; opacity: .15; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 70px 70px; mask-image: radial-gradient(ellipse at 70% 45%, black, transparent 65%); }
  .availability { display: inline-flex; align-items: center; gap: 8px; color: color-mix(in srgb, var(--muted) 82%, var(--text)); font: 500 11px 'DM Mono'; letter-spacing: .1em; }
  .availability i { width: 6px; height: 6px; border-radius: 50%; background: var(--green); box-shadow: 0 0 12px var(--green); }
  .hero h1 { margin: 25px 0 22px; max-width: 700px; font-size: clamp(65px, 8vw, 112px); line-height: .88; letter-spacing: -.075em; font-weight: 800; }
  .hero h1 em { color: transparent; font-style: normal; -webkit-text-stroke: 1px color-mix(in srgb, var(--blue-soft) 70%, var(--text)); background: linear-gradient(110deg, var(--blue-soft), #6a8fff); background-clip: text; -webkit-background-clip: text; }
  .hero-copy > p { max-width: 590px; margin: 0; color: var(--muted); font-size: 17px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 11px; margin-top: 33px; }
  .hero-stats { display: flex; gap: 37px; margin-top: 62px; }
  .hero-stats div { display: flex; flex-direction: column; }
  .hero-stats strong { font-size: 17px; }
  .hero-stats span { color: var(--subtle); font: 400 9px 'DM Mono'; text-transform: uppercase; letter-spacing: .09em; }
  .hero-visual { min-height: 510px; position: relative; transition: transform .15s ease-out; }
  .terminal { position: absolute; width: min(470px, 88%); left: 4%; top: 95px; z-index: 3; overflow: hidden; border: 1px solid rgba(109,193,239,.18); border-radius: 19px; background: rgba(4,14,25,.86); box-shadow: 0 42px 90px rgba(0,0,0,.38), inset 0 1px rgba(255,255,255,.04); backdrop-filter: blur(22px); transform: perspective(900px) rotateY(-5deg) rotateX(2deg); }
  .terminal-bar { height: 44px; display: flex; align-items: center; gap: 6px; padding: 0 15px; border-bottom: 1px solid rgba(255,255,255,.06); }
  .terminal-bar span { width: 7px; height: 7px; border-radius: 50%; background: #355065; }.terminal-bar span:first-child{background:#fa6d70}.terminal-bar span:nth-child(2){background:#f6bd4c}.terminal-bar span:nth-child(3){background:#56d58b}
  .terminal-bar em { margin-left: auto; margin-right: auto; color: #587184; font: 400 9px 'DM Mono'; font-style: normal; }
  .terminal-body { padding: 26px 27px 29px; color: #9bb3c5; font-size: 12px; }
  .terminal-body p { display: flex; align-items: center; gap: 9px; margin: 0 0 16px; }
  .terminal-body b { color: #51c8ff; }.terminal-body i{color:#54e4ac;font-style:normal}.terminal-body p span:not(.pulse){margin-left:auto;color:#4e6b7d}
  .terminal-body .ready { width: max-content; margin: 27px 0 0; padding: 8px 12px; border-radius: 8px; background: rgba(69,222,165,.08); color: #7be6bd; }
  .pulse { width: 5px; height: 5px; border-radius: 50%; background: #55e6ac; box-shadow: 0 0 9px #55e6ac; animation: pulse 2s infinite; }
  .float-card { position: absolute; z-index: 4; padding: 14px 17px; border: 1px solid var(--line); border-radius: 13px; background: var(--panel); backdrop-filter: blur(18px); box-shadow: 0 14px 35px rgba(0,0,0,.24); animation: float 5s ease-in-out infinite; }
  .float-card small { display: block; color: color-mix(in srgb, var(--subtle) 75%, var(--text)); font: 500 9px 'DM Mono'; letter-spacing: .1em; }
  .float-card strong { display: block; margin-top: 4px; font: 500 11px 'DM Mono'; }.float-card strong span{color:var(--blue)}
  .architecture { right: 0; top: 52px; }.registry{left:0;bottom:68px;animation-delay:-2.5s}.registry i{display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--green);margin-right:5px}
  .container-cube { position: absolute; z-index: 2; right: 4%; bottom: 32px; width: 140px; height: 140px; border: 1px solid rgba(53,185,255,.2); background: linear-gradient(145deg, rgba(53,185,255,.12), rgba(53,185,255,.02)); clip-path: polygon(50% 0, 100% 25%, 100% 76%, 50% 100%, 0 76%, 0 25%); display:grid;place-items:center;color:rgba(86,198,255,.5);font:500 12px 'DM Mono'; filter:drop-shadow(0 20px 45px rgba(21,125,215,.2)); }
  .orbit { position:absolute;border:1px solid rgba(53,185,255,.11);border-radius:50%; }.orbit-a{width:430px;height:430px;right:-80px;top:30px}.orbit-b{width:280px;height:280px;left:20px;bottom:10px}
  .ticker { overflow:hidden;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:rgba(255,255,255,.012); }
  .ticker div { width:max-content;display:flex;align-items:center;gap:34px;height:62px;animation:ticker 28s linear infinite;color:var(--subtle);font:500 9px 'DM Mono';letter-spacing:.14em }.ticker i{color:var(--blue);font-size:6px}
  .catalog { padding-top: 125px; scroll-margin-top: 20px; }
  .section-head { display:grid;grid-template-columns:1fr 420px;align-items:end;gap:35px }.section-head h2,.principles h2{margin:10px 0 0;font-size:clamp(40px,5vw,68px);line-height:1;letter-spacing:-.06em}.section-head p{margin:0;color:var(--muted);font-size:14px}
  .catalog-tools{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:45px 0 25px}.search{width:min(340px,100%);height:42px;display:flex;align-items:center;gap:8px;padding:0 14px;border:1px solid var(--line);border-radius:12px;background:var(--panel)}.search span{color:var(--subtle);font-size:20px}.search input{width:100%;border:0;outline:0;background:transparent;color:var(--text);font-size:12px}.filters{display:flex;gap:6px;overflow-x:auto;padding:3px}.filters button{white-space:nowrap;border:1px solid transparent;border-radius:999px;background:transparent;color:var(--muted);padding:8px 12px;font-size:10px;font-weight:700;cursor:pointer}.filters button.active{border-color:var(--line);background:var(--panel);color:var(--text)}
  .project-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:15px }.project-grid > [hidden]{display:none}.empty{text-align:center;color:var(--muted);padding:70px 0}
  .principles{display:grid;grid-template-columns:.8fr 1.2fr;gap:100px;padding-top:150px}.principle-list article{display:grid;grid-template-columns:50px 1fr;gap:12px;padding:27px 0;border-top:1px solid var(--line)}.principle-list article:last-child{border-bottom:1px solid var(--line)}.principle-list article>span{color:var(--blue);font:500 10px 'DM Mono'}.principle-list h3{margin:0 0 5px;font-size:17px}.principle-list p{margin:0;color:var(--muted);font-size:13px}
  .cta{margin-top:150px!important;min-height:300px;display:flex;align-items:center;justify-content:space-between;gap:35px;padding:54px!important;border:1px solid var(--line);border-radius:30px;background:radial-gradient(circle at 85% 20%,rgba(53,185,255,.15),transparent 35%),var(--panel);box-shadow:var(--shadow)}.cta h2{margin:9px 0;font-size:clamp(37px,5vw,62px);letter-spacing:-.06em;line-height:1}.cta p{max-width:640px;margin:0;color:var(--muted);font-size:14px}
  @keyframes float{50%{transform:translateY(-8px)}}@keyframes pulse{50%{opacity:.35}}@keyframes ticker{to{transform:translateX(-50%)}}
  @media(max-width:960px){.hero{grid-template-columns:1fr;padding-top:55px}.hero-visual{min-height:450px}.project-grid{grid-template-columns:repeat(2,1fr)}.section-head{grid-template-columns:1fr}.principles{grid-template-columns:1fr;gap:55px}.catalog-tools{align-items:flex-start;flex-direction:column}.filters{width:100%}}
  @media(max-width:640px){.hero{min-height:auto;padding:55px 0 60px}.hero h1{font-size:clamp(53px,16vw,61px)}.hero-copy>p{font-size:15px;line-height:1.75;text-wrap:pretty}.hero-stats{gap:18px;margin-top:42px}.hero-stats span{font-size:11px;letter-spacing:.03em;color:color-mix(in srgb,var(--muted) 88%,var(--text))}.hero-visual{min-height:390px;margin-top:10px}.terminal{top:70px;width:94%;left:3%;transform:none}.terminal-body{padding:24px 18px;font-size:12px;color:#abc1d0}.architecture{right:12px;top:25px;max-width:calc(100vw - 24px)}.architecture small{font-size:10px;color:#9eb4c4}.registry,.container-cube{display:none}.project-grid{grid-template-columns:1fr}.catalog{padding-top:90px}.section-head p{font-size:13px}.principles{padding-top:100px}.cta{padding:32px 24px!important;flex-direction:column;align-items:flex-start;margin-top:100px!important}.hero-actions .btn{width:100%}}
  @media(prefers-reduced-motion:reduce){.ticker div,.float-card,.pulse{animation:none}}
</style>
