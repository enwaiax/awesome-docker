---
import type { Project } from '../data/projects';

const { project, featured = false } = Astro.props as { project: Project; featured?: boolean };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<article
  class:list={['project-card', { featured }]}
  style={`--accent:${project.accent};--glow:${project.glow}`}
  data-project-card
  data-search={`${project.name} ${project.summary} ${project.category} ${project.tags.join(' ')}`.toLowerCase()}
  data-category={project.category}
  data-status={project.status}
>
  <div class="card-top">
    <span class="project-icon">{project.icon}</span>
    <span class:list={['status', project.status]}><i></i>{project.statusLabel}</span>
  </div>
  <div class="card-copy">
    <span class="eyebrow">{project.eyebrow}</span>
    <h3>{project.name}</h3>
    <p>{project.summary}</p>
  </div>
  <div class="chips">
    {project.architectures.slice(0, 3).map((arch) => <span class="chip">{arch}</span>)}
    {project.architectures.length > 3 && <span class="chip">+{project.architectures.length - 3}</span>}
  </div>
  <a class="card-link" href={`${base}/projects/${project.slug}`} aria-label={`查看 ${project.name}`}>
    <span>Explore image</span><b>↗</b>
  </a>
  <div class="card-glow" aria-hidden="true"></div>
</article>

<style>
  .project-card {
    position: relative;
    min-height: 365px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(145deg, rgba(255,255,255,.038), transparent 55%), var(--panel);
    box-shadow: 0 18px 50px rgba(0,0,0,.12);
    backdrop-filter: blur(16px);
    transition: transform .35s cubic-bezier(.2,.8,.2,1), border-color .35s, box-shadow .35s;
  }
  .project-card:hover { transform: translateY(-7px); border-color: color-mix(in srgb, var(--accent) 48%, transparent); box-shadow: var(--shadow); }
  .project-card.featured { grid-column: span 2; }
  .card-top { display: flex; align-items: center; justify-content: space-between; }
  .project-icon {
    display: grid;
    place-items: center;
    width: 51px;
    height: 51px;
    border-radius: 16px;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    font-size: 20px;
    font-weight: 800;
    box-shadow: inset 0 0 20px color-mix(in srgb, var(--accent) 6%, transparent);
  }
  .status { display: inline-flex; align-items: center; gap: 7px; color: var(--muted); font-size: 10px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .status i { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); }
  .status.archived i { background: #f59e0b; }
  .card-copy { margin-top: 56px; position: relative; z-index: 1; }
  .card-copy h3 { margin: 10px 0 8px; font-size: clamp(23px, 3vw, 31px); line-height: 1.1; letter-spacing: -.045em; }
  .card-copy p { max-width: 440px; margin: 0; color: var(--muted); font-size: 14px; }
  .chips { display: flex; flex-wrap: wrap; gap: 7px; margin-top: auto; padding-top: 24px; position: relative; z-index: 1; }
  .card-link { display: flex; align-items: center; justify-content: space-between; margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--text); font-size: 12px; font-weight: 800; position: relative; z-index: 1; }
  .card-link b { display: grid; place-items: center; width: 27px; height: 27px; border-radius: 50%; background: color-mix(in srgb, var(--accent) 14%, transparent); color: var(--accent); transition: transform .25s; }
  .project-card:hover .card-link b { transform: rotate(45deg); }
  .card-glow { position: absolute; width: 230px; height: 230px; top: -90px; right: -75px; border-radius: 50%; background: var(--glow); filter: blur(55px); opacity: .6; transition: opacity .3s; }
  .project-card:hover .card-glow { opacity: 1; }
  @media (max-width: 800px) { .project-card.featured { grid-column: span 1; } }
</style>
